{
  "name": "The Burden's Cast",
  "short_name": "Burden's Cast",
  "description": "Epic dungeon adventure game with tactical combat, dice rolling, and strategic gameplay",
  "start_url": "./index.html",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#1a1a1a",
  "theme_color": "#1a1a1a",
  "scope": "/burdenscast/app/",
  "icons": [
    {
      "src": "./burdens_cast.icon.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./burdens_cast.apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["games", "entertainment"],
  "prefer_related_applications": false
}

